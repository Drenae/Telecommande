<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The UI is entirely rendered with Jetpack Compose / Material 3.
        Keep the platform theme dependency-free: Compose applies the actual
        application colors in TelecommandeTheme.
    -->
    <style name="Theme.Telecommande" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Telecommande.NoActionBar" parent="Theme.Telecommande" />
</resources>
